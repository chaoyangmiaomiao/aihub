<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="spring.ai.mapper.AisessionMapper">
    <select id="selectChatIds" parameterType = "String" resultType="String">
        select chatid from aisession where type = #{type}
    </select>
    <insert id = "addChatHistory" parameterType = "spring.ai.entity.po.Aisession">
        insert ignore into aisession(type, chatid) values (#{type}, #{chatid})
    </insert>
</mapper>
